# ============================================================
# TITAN BUSINESS OS — Variables de Entorno
# Copiar este archivo como .env y modificar los valores
# ============================================================

# --- GENERAL ---
NODE_ENV=development
ENVIRONMENT=local

# --- FRONTEND ---
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=TITAN Business OS

# --- BACKEND ---
JWT_SECRET=change_this_to_a_random_secret_key_at_least_32_chars
JWT_EXPIRATION=24h
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- DATABASE ---
POSTGRES_USER=titan
POSTGRES_PASSWORD=titan_secret
POSTGRES_DB=titan_db
DATABASE_URL=postgresql://titan:titan_secret@localhost:5432/titan_db

# --- REDIS ---
REDIS_URL=redis://localhost:6379

# --- AI PROVIDERS (Etapa 5) ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# AI_DEFAULT_PROVIDER=openai
# AI_DEFAULT_MODEL=gpt-4o-mini

# --- STORAGE ---
# S3_BUCKET=titan-documents
# S3_REGION=eu-west-1
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...

# --- EMAIL ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASSWORD=...
# SMTP_FROM=noreply@titan.example.com

# --- MONITORING ---
# SENTRY_DSN=...
# LOG_LEVEL=info

# --- SECURITY ---
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW=60
# MAX_UPLOAD_SIZE_MB=10
